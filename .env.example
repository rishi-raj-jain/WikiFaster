# Direct (unpooled) Neon connection string, used by the app, the migrate script, and the Python ingest.
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
AWS_ENDPOINT_URL_S3="https://...storage.c-7.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_REGION="us-east-2"
# Bearer token for POST /api/revalidate. Generate with `openssl rand -hex 32`.
REVALIDATE_SECRET="..."
# Bearer token Vercel Cron sends to /api/cron/main-page (every 12 hours, see vercel.json). Generate the same way.
CRON_SECRET="..."